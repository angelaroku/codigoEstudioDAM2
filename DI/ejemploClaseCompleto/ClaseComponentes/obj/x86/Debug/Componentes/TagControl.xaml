<UserControl x:ConnectionId='1'
    x:Class="ClaseComponentes.Components.TagControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClaseComponentes.Components"
    Width="125" Height="120">
    <Border x:ConnectionId='2' x:Name="TagBorder"
            Background="#FFEFEFEF"
            CornerRadius="6"
            Padding="8,3"
            VerticalAlignment="Center">
		<StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
			<SymbolIcon x:ConnectionId='3' x:Name="TagIcon"                                />
			<TextBlock x:ConnectionId='4' x:Name="TagTextBlock"                              />
		</StackPanel>
    </Border>
</UserControl>

