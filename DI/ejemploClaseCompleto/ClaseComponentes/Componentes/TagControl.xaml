<UserControl
    x:Class="ClaseComponentes.Components.TagControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClaseComponentes.Components"
    Width="125" Height="120">
    <Border x:Name="TagBorder"
            Background="#FFEFEFEF"
            CornerRadius="6"
            Padding="8,3"
            VerticalAlignment="Center">
		<StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
			<SymbolIcon x:Name="TagIcon" Symbol="{x:Bind IconoEtiqueta}"/>
			<TextBlock x:Name="TagTextBlock" Text="{x:Bind TextoEtiqueta}"/>
		</StackPanel>
    </Border>
</UserControl>